# Copy to .env.local for local development, and set the same variables in the
# Vercel project settings for preview/production. Values are never committed —
# .gitignore ignores .env*, so this example file is force-added.

# ── Email delivery (Resend) ──────────────────────────────────────────────────
# The contact form has no database behind it: the notification email IS the
# lead. Without these, /api/contact returns 500.
RESEND_API_KEY=
# Inbox that receives contact form submissions.
NOTIFICATION_EMAIL=

# ── Bot protection (self-hosted, no third party) ─────────────────────────────
# Signs the short-lived tokens the contact form must present, so a script that
# POSTs straight to /api/contact without loading the page is rejected.
#
# Generate a value (any long random string):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Must be identical across all instances of a deployment — do NOT generate it at
# runtime, or tokens minted by one lambda would fail on another. If unset, the
# form still works but submissions are only flagged, never blocked.
CONTACT_TOKEN_SECRET=
